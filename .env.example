# Runtime
NODE_ENV=development
PORT=3000
DEFAULT_ORG_ID=1

# PostgreSQL (alternatively set DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=afc
PGUSER=afc
PGPASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# AFC sessions
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=afc_sid
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Google OAuth credentials (server only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAIL_DOMAIN=

# Existing direct popup mode for local development
GOOGLE_OAUTH_REDIRECT_URI=https://localhost:5173

# Public gateway URL (ngrok, Cloudflare Tunnel or native HTTPS)
PUBLIC_URL=https://reclining-sulfur-reward.ngrok-free.dev
GOOGLE_CALLBACK_URL=https://reclining-sulfur-reward.ngrok-free.dev/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=300
GOOGLE_OAUTH_STATE_COOKIE_NAME=afc_google_oauth_state

# Full health-check dependency timeout
HEALTHCHECK_TIMEOUT_MS=5000

# Bulk student CSV import limits (server-enforced upper bounds)
BULK_STUDENT_IMPORT_MAX_FILE_BYTES=2097152
BULK_STUDENT_IMPORT_MAX_ROWS=1000
BULK_STUDENT_IMPORT_PREVIEW_TTL_SECONDS=600

# The gateway connects to Express from loopback
TRUST_PROXY=loopback

# Current HTTP front plus public HTTPS gateway
CORS_ALLOW_ANY_ORIGIN=false
CORS_ORIGIN=http://localhost:3005,https://reclining-sulfur-reward.ngrok-free.dev,http://localhost:5173,https://localhost:5173,https://vite.localhost:5173,http://ecosistemadigital.aragon.unam.mx:3005,http://132.248.44.4:3005

# Used only when this image starts with: node gateway/server.js
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3010
AFC_FRONT_TARGET=http://afc-front:3000
AFC_BACK_TARGET=http://afc-back:3000
