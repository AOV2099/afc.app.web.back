FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

ENV NODE_ENV=production
ENV REDIS_URL=redis://redis-stack:6379
ENV PORT=3000
ENV PGHOST=postgres
ENV PGPORT=5432
ENV PGDATABASE=afc
ENV PGUSER=postgres
ENV PGPASSWORD=""

ENV GOOGLE_CLIENT_ID=""
ENV GOOGLE_CLIENT_SECRET=""
ENV GOOGLE_OAUTH_REDIRECT_URI=""
ENV GOOGLE_ALLOWED_EMAIL_DOMAIN=""
ENV PUBLIC_URL=""
ENV GOOGLE_CALLBACK_URL=""
ENV GOOGLE_OAUTH_STATE_TTL_SECONDS="300"
ENV GOOGLE_OAUTH_STATE_COOKIE_NAME="afc_google_oauth_state"
ENV HEALTHCHECK_TIMEOUT_MS="5000"
ENV TRUST_PROXY=""
ENV CORS_ALLOW_ANY_ORIGIN="false"
ENV CORS_ORIGIN=""

EXPOSE 3000

CMD ["npm", "start"]